# Gateway Port & Host
PORT=8788
HOST=0.0.0.0

# Administrator Authentication (REQUIRED - Server will fail-closed if missing)
# Generate a strong 48-char random secret using: openssl rand -hex 24
ADMIN_PASSWORD=replace_with_strong_random_admin_secret

# Upstream Frontier LLM Provider
UPSTREAM_BASE_URL=https://api.justwoker.icu/v1
UPSTREAM_API_KEY=your_upstream_api_key_here
UPSTREAM_MODEL=claude-opus-5

# Optional Additional Providers (Fallback Chain)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Gateway Features
ALBATROSS_CACHE_ENABLED=true
ALBATROSS_SIMILARITY_THRESHOLD=0.90
ALBATROSS_GUARDRAILS_ENABLED=true
